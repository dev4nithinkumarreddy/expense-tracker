# Copy this file to .env and fill in your own values.
# NEVER commit .env — it is in .gitignore.

# ── Supabase (required) ────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>

# ── Web Push / VAPID (required for push notifications) ────────────────────────
# Generate a new pair with: npx web-push generate-vapid-keys
# The PUBLIC key goes here (client-side). Store the PRIVATE key only in
# Supabase Edge Function secrets (never here).
VITE_VAPID_PUBLIC_KEY=<your-vapid-public-key>

# ── Admin access (optional) ───────────────────────────────────────────────────
# Comma-separated list of emails that should have admin access in addition
# to entries in the admin_users table. Treated as client-visible — do NOT
# put service credentials here.
VITE_ADMIN_EMAILS=
